  "regime_rules": {
    "intervals_inclusive": true,
    "partial_transition_months": "Exclude whole affected calendar month",
    "target_eligibility": "Origin and every calendar month through t+h must be observed, positive, and outside excluded FX intervals.",
    "fx_lag_history": "Reset FX lag and rolling-return histories at currency launch, regime exclusions, or missing FX; do not bridge gaps.",
    "other_pegs": "Retain EUR-linked and managed/crawling arrangements that can move against USD; sensitivity excludes EUR-linked currencies.",
    "china_sensitivity": "Alternative formal-policy cutoff: exclude through 2005-07 instead of 2006-07; keep the conservative 2008-06 to 2010-06 exclusion.",
    "evaluation_scope": "Retrospective non-peg sample restriction; not a claim that future regime changes were known at forecast origin."
  },
  "macro_availability": {
    "forecast_origin": "End of calendar month t",
    "reference_lags_months": {
      "fx": 0,
      "policy": 1,
      "cpi_inflation": 2,
      "reer": 2,
      "usd_neer": 1
    },
    "usd_credit_quarter_lag": 2,
    "usd_credit_series": "Q:USD:3P:N:A:I:B:USD",
    "credit_mapping": "Quarter containing t minus 2, held fixed within the origin quarter; no interpolation or extra carry.",
    "vintage_scope": "Latest revised BIS histories with conservative reference-period lags; pseudo out of sample, not real-time vintage evaluation."
  },
  "missing_data": {
    "fx": "No filling. Missing/nonpositive observations invalidate dependent targets and lag histories.",
    "policy": {
      "causal_carry_limit_months": 1,
      "negative_and_zero_rates": "Retain as valid",
      "long_runs": "Only first missing month may use a flagged carry; subsequent missing months stay null.",
      "national_euro_histories": "Do not splice; EUR uses XM from 1999; national EUR representatives are absent."
    },
    "inflation": {
      "definition": "100 * log(CPI_t / CPI_(t-12))",
      "causal_carry_limit_months": 1,
      "carry_object": "Derived YoY log inflation, never the CPI level",
      "us_2025_10": "Use September 2025 YoY log inflation as a flagged October fallback; enters December origin under 2m lag.",
      "future_values": "No backward fill or two-sided interpolation."
    },
    "reer_neer": "No filling. Availability lag is applied before feature construction.",
    "usd_credit": "No filling; native quarterly history and exact lag lookup retained.",
    "model_domain": {
      "mandatory_observed": "FX lag/rolling inputs, REER and USD NEER inputs; credit additionally mandatory for matched credit ablations.",
      "optional_macro_features": "Policy and inflation differentials can remain null in the persisted panel.",
      "training_imputation": "Training-window-only pooled median plus explicit missing indicators; no median fitted across future origins.",
      "structural_missing": "Retain currency; preserve never-available flags. Use same origins and treatment for compared models.",
      "entire_training_feature_missing": "Drop identically for all compared models or fail; never learn replacement from evaluation data.",
      "sensitivities": [
        "Strict complete-case macro comparison on matched origins",
        "Exclude all rows using a causal carry",
        "Omit optional macro features"
      ]
    },
    "required_flags": [
      "policy_carried_domestic",
      "policy_carried_us",
      "inflation_carried_domestic",
      "inflation_carried_us",
      "policy_missing",
      "inflation_missing",
      "policy_source_absent",
      "cpi_source_absent",
      "fx_regime_excluded"
    ]
  },
  "outliers": {
    "primary": "Retain observed large moves; log transforms only on positive FX/CPI/EER/credit.",
    "break_treatment": "Exclude only independently documented unit/source breaks; record rationale. No full-sample threshold trimming."
